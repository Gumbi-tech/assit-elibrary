generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  LECTURER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses   Course[]
  users     User[]
  documents Document[]
}

model Course {
  id           String     @id @default(cuid())
  title        String
  code         String     @unique
  description  String?
  credits      Int        @default(3)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  documents    Document[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  documents   Document[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Program {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  documents   Document[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  documents Document[]
  createdAt DateTime   @default(now())
}

model Document {
  id          String  @id @default(cuid())
  name        String
  title       String?
  author      String?
  description String?
  filename    String
  path        String
  size        Int
  mimeType    String  @default("application/pdf")

  // New open-library taxonomy & discovery
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  programs   Program[]
  tags       Tag[]

  // Retained for backward compatibility with existing app version
  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?    @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
  @@index([courseId])
  @@index([departmentId])
  @@index([uploadedById])
}

model User {
  id                 String        @id @default(cuid())
  studentId          String?       @unique
  email              String        @unique
  passwordHash       String
  fullName           String
  role               Role          @default(STUDENT)
  status             AccountStatus @default(ACTIVE)
  department         String?
  departmentId       String?
  departmentRef      Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  program            String?
  yearOfStudy        Int?
  phone              String?
  profileData        Json?
  mustChangePassword Boolean       @default(true)
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  uploadedDocuments Document[] @relation("UploadedDocuments")

  @@index([role])
  @@index([status])
  @@index([department])
  @@index([departmentId])
}
