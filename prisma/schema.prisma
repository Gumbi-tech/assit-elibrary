generator client {
  provider = "prisma-client-js"
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  courses     Course[]
  
  @@map("departments")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  code        String   @unique
  description String?
  department  Department @relation(fields: [departmentId], references: [id])
  departmentId String
  credits     Int
  createdAt   DateTime @default(now())
  
  documents   Document[]
  
  @@map("courses")
}

model Document {
  id          String   @id @default(uuid())
  name        String
  filename    String
  path        String
  size        Int
  mimeType    String
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  uploadedAt  DateTime @default(now())
  
  @@map("documents")
}