generator client {
  provider = "prisma-client-js"
}



enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id                 String        @id @default(cuid())
  studentId          String?       @unique
  email              String        @unique
  passwordHash       String
  fullName           String
  role               Role          @default(STUDENT)
  status             AccountStatus @default(ACTIVE)
  department         String?
  program            String?
  yearOfStudy        Int?
  phone              String?
  profileData        Json?
  mustChangePassword Boolean       @default(true)
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([role])
  @@index([status])
  @@index([department])
}


